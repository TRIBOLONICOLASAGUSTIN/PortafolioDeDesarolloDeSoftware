# Variables de entorno de atc-app (SIN valores reales: este archivo sí va al repo).
# Las reales van en .env.local (desarrollo) o en la configuración del hosting (producción). Nunca en el repo.
# Ninguna de estas lleva el prefijo NEXT_PUBLIC_: no se mandan al navegador.

# Superadmin del panel — se generan con: npm run admin:setup (Windows: npm.cmd run admin:setup)
# En producción, claves propias: npm run admin:setup -- --prod (nunca copiar las de la compu).
ATC_ADMIN_USER=
ATC_ADMIN_PASS_HASH=
ATC_ADMIN_TOTP_SECRET=
ATC_SESSION_SECRET=

# Producción (ver docs/atc/seguridad.md §8)
ATC_TRACKER_DATABASE_URL=
# Pedidos de la bolsa: conexión como atc_tienda (solo puede ejecutar crear_pedido)
ATC_TIENDA_DATABASE_URL=
# Pagos del panel: conexión como atc_panel (solo registrar pagos y ver o borrar comprobantes, después de la sesión)
ATC_PANEL_DATABASE_URL=
# Llaves de los comprobantes (las genera npm run admin:setup). La PUBLICA cifra (el servidor no puede abrir); la PRIVADA
# está bloqueada con la frase del dueño, que admin:setup muestra una sola vez y va SOLO al gestor de contraseñas (nunca
# acá ni en el hosting). Sin la frase, los comprobantes guardados no se abren. Cambiar la frase: --cambiar-frase.
ATC_COMPROBANTES_PUBLICA=
ATC_COMPROBANTES_PRIVADA=
ATC_IP_HEADER=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Certificado (PEM) de la CA de Supabase: Database → Settings → SSL. La conexión a la base va cifrada y verificada.
ATC_DB_CA=

# Buscadores: dirección pública del sitio (canónicas, Open Graph, sitemap) y si se indexa.
# ATC_INDEXAR=1 recién cuando estén los datos reales del dueño (con datos de ejemplo, noindex y robots "Disallow: /").
ATC_SITE_URL=
ATC_INDEXAR=
