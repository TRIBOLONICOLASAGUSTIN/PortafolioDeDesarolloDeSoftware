# Variables de entorno de atc-app (SIN valores reales: este archivo sí va al repo).
# Las reales van en .env.local (desarrollo) o en la configuración del hosting (producción). Nunca en el repo.
# Ninguna de estas lleva el prefijo NEXT_PUBLIC_: no se mandan al navegador.

# Superadmin del panel — se generan con: npm run admin:setup (Windows: npm.cmd run admin:setup)
ATC_ADMIN_USER=
ATC_ADMIN_PASS_HASH=
ATC_ADMIN_TOTP_SECRET=
ATC_SESSION_SECRET=

# Producción (ver docs/atc/seguridad.md §8)
ATC_TRACKER_DATABASE_URL=
ATC_IP_HEADER=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
